{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "version": "3.0.2",
  "permissions": ["storage", "unlimitedStorage"],
  "optional_permissions": ["topSites", "favicon"],
  "icons": {
