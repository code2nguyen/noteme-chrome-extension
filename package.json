{
  "name": "noteme-chrome-extension",
  "version": "3.0.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/build-worker.ts",
    "build:worker": "node scripts/build-worker.ts",
    "watch": "ng build --watch --configuration development",
    "watch:worker": "node scripts/build-worker.ts --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e": "npm run build && playwright test",
    "package": "node scripts/package-extension.ts",
    "c2n:link": "node scripts/link-c2n.ts",
    "c2n:unlink": "node scripts/link-c2n.ts --unlink",
    "changelog": "node scripts/changelog.ts",
    "theme": "node scripts/theme-subset.ts",
    "version": "node scripts/package-extension.ts --sync && node scripts/changelog.ts --next && git add src/manifest.json CHANGELOG.md"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@c2n/components": "1.0.26",
    "@c2n/core": "1.0.26",
    "@c2n/feather-icons": "1.0.26",
    "@c2n/phosphor-icons": "1.0.26",
    "@c2n/symbols": "1.0.26",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/store": "22.0.1",
    "fuse.js": "7.5.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@c2n/mcp": "1.0.26",
    "@c2n/skill": "1.0.26",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.19.1",
    "angular-eslint": "22.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,html,scss,json,md}": "prettier --write"
  }
}
